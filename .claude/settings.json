{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv build:*)",
      "Bash(uv lock:*)",
      "Bash(uv add:*)",
      "Bash(uv venv:*)",
      "Bash(uv --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(git --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git init:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(uv publish:*)",
      "Bash(twine:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.pypirc)"
    ]
  }
}
